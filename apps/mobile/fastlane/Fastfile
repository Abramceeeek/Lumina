default_platform(:ios)

APP_ID = "com.abramceeeek.lumina"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"]
  )
end

platform :ios do
  # One-time cleanup: revoke distribution certs orphaned by earlier CI runs.
  lane :clean_certs do
    asc_api_key
    require "spaceship"
    Spaceship::ConnectAPI::Certificate.all.each do |c|
      next unless c.certificate_type.to_s.include?("DISTRIBUTION")
      UI.message("Revoking distribution cert #{c.id} (#{c.certificate_type})")
      begin
        c.delete!
      rescue => e
        UI.important("Could not revoke #{c.id}: #{e.message}")
      end
    end
  end

  # Install the distribution cert + App Store profile via match and switch the
  # project to manual signing with them. The actual build runs via raw xcodebuild
  # in the workflow (gym mis-handles RN 0.85's Swift package resolution).
  lane :setup_signing do
    api_key = asc_api_key

    create_keychain(
      name: "ci.keychain",
      password: "ci_pass",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: APP_ID,
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: "match-certs",
      storage_mode: "git",
      readonly: false,
      keychain_name: "ci.keychain",
      keychain_password: "ci_pass"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/Lumina.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_ID],
      targets: ["Lumina"]
    )
  end

  # Upload an already-built .ipa (path in IPA_PATH) to TestFlight.
  lane :upload do
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: ENV["IPA_PATH"],
      skip_waiting_for_build_processing: true
    )
  end
end
