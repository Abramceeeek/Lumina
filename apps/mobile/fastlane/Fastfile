default_platform(:ios)

APP_ID = "com.abramceeeek.lumina"

platform :ios do
  # Build the iOS app with App Store (distribution) signing and ship to TestFlight.
  # Everything is driven by the App Store Connect API key — no devices, no Mac,
  # no manual portal steps.
  lane :beta do
    setup_ci # temporary CI keychain for the signing identity

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    # Register the App ID + App Store Connect app record if they don't exist yet
    # (idempotent — skips when already present).
    produce(
      app_identifier: APP_ID,
      app_name: "Lumina",
      language: "English",
      sku: "lumina001",
      platforms: ["ios"],
      team_id: ENV["APPLE_TEAM_ID"]
    )

    # Distribution certificate (created headlessly via the API if none exists).
    cert(api_key: api_key)

    # App Store provisioning profile — distribution type, needs no registered devices.
    sigh(api_key: api_key, app_identifier: APP_ID, platform: "ios")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/Lumina.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ["Lumina"]
    )

    build_app(
      workspace: "ios/Lumina.xcworkspace",
      scheme: "Lumina",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { APP_ID => lane_context[SharedValues::SIGH_NAME] }
      }
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
