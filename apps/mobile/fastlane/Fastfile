default_platform(:ios)

APP_ID = "com.abramceeeek.lumina"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"]
  )
end

platform :ios do
  # One-time cleanup: revoke distribution certs orphaned by earlier CI runs, so
  # match can create + store a fresh one within Apple's 2-certificate limit.
  lane :clean_certs do
    asc_api_key
    require "spaceship"
    Spaceship::ConnectAPI::Certificate.all.each do |c|
      next unless c.certificate_type.to_s.include?("DISTRIBUTION")
      UI.message("Revoking distribution cert #{c.id} (#{c.certificate_type})")
      begin
        c.delete!
      rescue => e
        UI.important("Could not revoke #{c.id}: #{e.message}")
      end
    end
  end

  # Build with App Store (distribution) signing via match, ship to TestFlight.
  lane :beta do
    api_key = asc_api_key

    keychain_name = "ci.keychain"
    keychain_password = "ci_pass"
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # match creates ONE distribution cert + App Store profile, stores them
    # encrypted in the repo (branch match-certs), and reuses them every run.
    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: APP_ID,
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: "match-certs",
      storage_mode: "git",
      readonly: false,
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_ID]
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/Lumina.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["Lumina"]
    )

    build_app(
      workspace: "ios/Lumina.xcworkspace",
      scheme: "Lumina",
      export_method: "app-store",
      disable_package_automatic_updates: true,
      export_options: { provisioningProfiles: { APP_ID => profile_name } }
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
